<Window x:Class="Sandun.PptRepairTool.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SANDUN 插件维护中心" Width="984" Height="744" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" WindowStartupLocation="CenterScreen" Background="Transparent" UseLayoutRounding="True" FontFamily="Microsoft YaHei UI">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#F4F6F9"/><Setter Property="Foreground" Value="#46556B"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#8498AF"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem">
 <Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="23,14"/><Setter Property="Foreground" Value="#8490A0"/><Setter Property="Cursor" Value="Hand"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Grid Background="Transparent"><Border Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="HeaderPresenter" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border x:Name="Underline" Height="3" Width="24" CornerRadius="2" VerticalAlignment="Bottom" Background="Transparent"/></Grid><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#25282D"/><Setter TargetName="HeaderPresenter" Property="TextElement.FontWeight" Value="SemiBold"/><Setter TargetName="Underline" Property="Background" Value="#F45762"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#25282D"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Underline" Property="Background" Value="#8498AF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
 </Window.Resources>
 <Border Margin="12" CornerRadius="18" Background="White" BorderBrush="#E6EAF0" BorderThickness="1"><Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.12" Color="#263449"/></Border.Effect>
 <Grid Background="Transparent">
  <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="42"/></Grid.RowDefinitions>
  <Border Background="White" CornerRadius="18,18,0,0" BorderBrush="#E6EAF0" BorderThickness="0,0,0,1"><Grid x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="30,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="SANDUN" FontSize="22" FontWeight="Bold" Foreground="#182333"/><TextBlock Text="  插件维护中心" FontSize="15" Foreground="#7F8A9A" VerticalAlignment="Center" Margin="10,4,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="PrivilegeText" Text="管理员模式" Foreground="#2C9B88" VerticalAlignment="Center" Margin="0,0,18,0"/><Button x:Name="RefreshButton" Content="重新检测" Background="#EEF2F7" Foreground="#3B4A60" Click="Refresh_Click"/><Button x:Name="MinimizeButton" Width="32" Height="32" Padding="0" Background="Transparent" Click="Minimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化"><Path Data="M 0,5 L 10,5" Stroke="#8490A0" StrokeThickness="1.3" Width="10" Height="10"/></Button><Button x:Name="CloseButton" Width="32" Height="32" Padding="0" Background="Transparent" Click="Close_Click" ToolTip="关闭" AutomationProperties.Name="关闭"><Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="#8490A0" StrokeThickness="1.3" Width="10" Height="10"/></Button></StackPanel></Grid></Border>
  <TabControl x:Name="Tabs" Grid.Row="1" Margin="22,15" Background="Transparent" BorderThickness="0">
   <TabItem Header="检测修复"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,10,12,30"><Border Background="#182333" CornerRadius="12" Padding="23,19" Margin="0,0,0,10"><Grid><StackPanel Margin="0,0,145,0"><TextBlock Text="让 PowerPoint 与 WPS 都能看见 SANDUN" Foreground="White" FontSize="19" FontWeight="SemiBold"/><TextBlock TextWrapping="Wrap" x:Name="SummaryText" Text="正在读取安装状态…" Foreground="#B8C5D6" FontSize="13" Margin="0,8,0,0"/></StackPanel><Button x:Name="RepairAllButton" Content="一键修复" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FF5660" Foreground="White" Padding="22,12" Click="RepairAll_Click"/></Grid></Border><WrapPanel x:Name="InfoChips" Margin="0,0,0,13"/><StackPanel x:Name="ChecksPanel"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="安装 / 卸载"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="25,20"><TextBlock Text="版本管理" FontSize="21" FontWeight="SemiBold" Foreground="#182333"/><TextBlock Text="选择要维护的版本，安装器会保留原有目录并执行对应的注册步骤。" Foreground="#7F8A9A" Margin="0,7,0,20"/><Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,12"><Grid><StackPanel Margin="0,0,220,0"><TextBlock Text="商业版" FontSize="17" FontWeight="SemiBold"/><TextBlock TextWrapping="Wrap" x:Name="CommercialInstallState" Text="未检测" Foreground="#7F8A9A" Margin="0,7,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="安装 / 更新" Background="#182333" Foreground="White" Click="InstallCommercial_Click"/><Button Content="卸载" Background="#FBECEE" Foreground="#C53A4C" Click="UninstallCommercial_Click"/></StackPanel></Grid></Border><Border Background="White" CornerRadius="10" Padding="20"><Grid><StackPanel Margin="0,0,220,0"><TextBlock Text="开源版" FontSize="17" FontWeight="SemiBold"/><TextBlock TextWrapping="Wrap" x:Name="OpenInstallState" Text="未检测" Foreground="#7F8A9A" Margin="0,7,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="安装 / 更新" Background="#182333" Foreground="White" Click="InstallOpen_Click"/><Button Content="卸载" Background="#FBECEE" Foreground="#C53A4C" Click="UninstallOpen_Click"/></StackPanel></Grid></Border></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="组件维护"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="25,20"><TextBlock Text="单项维护" FontSize="21" FontWeight="SemiBold" Foreground="#182333"/><TextBlock Text="只处理选中的组件，适合修复部分可用、Ribbon 不出现或 WPS 不加载的情况。" Foreground="#7F8A9A" Margin="0,7,0,20"/><Border Background="White" CornerRadius="10" Padding="20"><StackPanel><Button Content="修复 Office / WPS 注册" HorizontalContentAlignment="Left" Click="RepairRegistration_Click"/><Separator/><Button Content="修复 WPS 在线插件配置" HorizontalContentAlignment="Left" Click="RepairWps_Click"/><Separator/><Button Content="启动本地核心服务（保持运行）" HorizontalContentAlignment="Left" Click="StartCore_Click"/><Separator/><Button Content="清理 Office 禁用项" HorizontalContentAlignment="Left" Click="ClearDisabled_Click"/><Separator/><Button Content="生成诊断报告" HorizontalContentAlignment="Left" Click="Report_Click"/></StackPanel></Border><TextBlock x:Name="ActionText" Foreground="#5B6B80" TextWrapping="Wrap" Margin="5,18,5,0"/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <Border Grid.Row="2" x:Name="OperationBanner" Visibility="Collapsed" Background="#FFF7E8" CornerRadius="8" Padding="14,10" Margin="30,0,30,8"><ScrollViewer MaxHeight="135" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="OperationText" TextWrapping="Wrap" FontSize="13" Foreground="#465E78" /></ScrollViewer></Border>
  <Border Grid.Row="3" CornerRadius="0,0,18,18" Background="White" BorderBrush="#E6EAF0" BorderThickness="0,1,0,0"><TextBlock x:Name="FooterText" Text="检测结果仅保存在本机诊断目录" Foreground="#98A3B2" Margin="30,0" VerticalAlignment="Center"/></Border>
 </Grid>
 </Border>
</Window>




